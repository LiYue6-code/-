<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.employment.mapper.JobMapper">

    <sql id="columns">
        j.*,
        c.name AS company_name
    </sql>

    <sql id="baseFrom">
        FROM job j
        LEFT JOIN company c ON j.company_id = c.id
    </sql>

    <!-- 学生端只展示招聘中的岗位；关键字同时匹配岗位名称与单位名称 -->
    <sql id="studentWhere">
        <where>
            j.status = '招聘中'
            <if test="q.keyword != null and q.keyword != ''">
                AND (j.title LIKE CONCAT('%', #{q.keyword}, '%')
                OR c.name LIKE CONCAT('%', #{q.keyword}, '%'))
            </if>
            <if test="q.companyId != null">
                AND j.company_id = #{q.companyId}
            </if>
        </where>
    </sql>

    <select id="search" resultType="com.employment.entity.Job">
        SELECT <include refid="columns"/>
        <include refid="baseFrom"/>
        <include refid="studentWhere"/>
        ORDER BY j.publish_time DESC, j.id DESC
        LIMIT #{q.size} OFFSET #{q.offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFrom"/>
        <include refid="studentWhere"/>
    </select>

</mapper>
